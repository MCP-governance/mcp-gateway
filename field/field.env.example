# 솔루션 기기에서: cp field/field.env.example .env 후 값을 채운다. .env는 커밋하지 않는다(.gitignore).

# 직원 PC가 접속할 이름. 사내 DNS 또는 각 PC의 hosts 파일이 이 이름을 기기 IP로 가리켜야 한다.
APPLIANCE_HOST=mcp-gw.internal
# 443을 게시할 이 기기의 사내망 IP(ip -4 addr). 0.0.0.0은 모든 인터페이스를 연다 - 쓰지 않는다.
APPLIANCE_BIND=192.168.0.10
# 콘솔(/console)과 관리 API(/admin)를 열어 줄 관리자 PC 대역. 여러 개는 따옴표 안에 공백으로("a/32 b/24").
# WSL2·Docker Desktop처럼 원래 IP가 보이지 않는 기기에서는 README의 주의를 따른다.
ADMIN_CIDR=192.168.0.20/32

# 콘솔 로그인 토큰(16자 이상). 생성: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MCP_PROXY_ADMIN_TOKEN=

# 기기 안에서만 쓰는 loopback 포트(점검·SSH 터널용).
MCP_PROXY_PORT=8080
# 실제 서버를 붙인 자기 설정 파일(기본: field/proxy.field.toml).
# MCP_PROXY_FIELD_CONFIG=./field/proxy.local.toml
