# MINT 운영 배포 설정. ./install.sh가 이 파일을 .env로 복사하고 비어 있는 비밀 값을 생성해 채운다(.env는 0600).
# 직접 채울 때는 각 줄 위의 명령으로 만든다. 비밀 값을 이 예시 파일이나 저장소에 적지 않는다.

# ── 게시 주소 ────────────────────────────────────────────────────────────────
# 관리형 직원 PC만 닿는 이 서버의 사내 IPv4(VPN·사설 구간). 0.0.0.0·127.0.0.1은 받지 않는다.
# Caddy(HTTPS 443)와 모델 프록시(3128) 두 포트만 이 주소에 게시된다.
MINT_BIND=
# 인증서에 함께 넣을 DNS 이름(선택). 직원 PC 설정의 주소는 MINT_BIND이다.
MINT_PUBLIC_NAME=
MODEL_PROXY_PORT=3128
# 내부 컨테이너 망 /16의 앞 두 자리. 사내 대역과 겹치면 바꾼다.
MINT_NET_PREFIX=10.246

# ── 비밀 값(설치 스크립트가 생성) ───────────────────────────────────────────
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 24
GITEA_ADMIN_PASSWORD=
GITEA_ADMIN_USER=mintadmin
# openssl rand -hex 24  (가져온 직원 계정의 초기 비밀번호 채움용. 로그인에 쓰지 않는다)
MOCK_SSO_PASSWORD=
# openssl rand -hex 24 | sed 's/^/fp-/'
FLOW_FINGERPRINT_PEPPER=
# openssl rand -base64 32 | tr '+/' '-_'   (잃으면 직원이 연결한 자격이 모두 「연결 안 됨」이 된다 — 백업 필수)
USER_CREDENTIAL_KEY=
# docker compose run --rm --no-deps -T --entrypoint python gateway -m app.keygen
AGENT_JWT_PRIVATE_KEY=
AGENT_JWT_PUBLIC_KEY=
# docker compose run --rm --no-deps -T --entrypoint python gateway -m app.keygen disposal
DISPOSAL_PRIVATE_KEY=
DISPOSAL_PUBLIC_KEY=
# 로컬 MCP 실행 매니페스트 서명 키(Ed25519 PEM, 줄바꿈은 \n). 오프라인 서명만 쓰면 공개 키만 넣고 개인 키는 비운다.
# openssl genpkey -algorithm ed25519
LOCAL_MANIFEST_PRIVATE_KEY=
LOCAL_MANIFEST_PUBKEY=

# ── 운영 정책 ────────────────────────────────────────────────────────────────
# 1이면 관리자 root 혼자 승인할 수 있다. 0이면 신청자와 다른 관리자가 승인한다(권장).
ROOT_SOLO_APPROVAL=0
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_HOURS=8
# coarse: 다른 서버에서 중요정보를 읽은 뒤의 쓰기·실행을 모두 막는다. content: 내용이 같을 때만 막는다.
FLOW_MATCH_MODE=coarse
TERMINATION_SLA_DAYS=14
CONNECTOR_REVIEW_DAYS=14
AUTO_SUSPEND_THRESHOLD=5
AUTO_SUSPEND_WINDOW_SECONDS=600
AUTO_SUSPEND_DURATION_SECONDS=900
TOOL_SUNSET_IDLE_DAYS=90
# 판정 풀(tools/call). max_waiting 0=대기 요청 수 무제한.
DB_POOL_MAX=10
DB_POOL_TIMEOUT=10
DB_POOL_MAX_WAITING=0
# 0=타임아웃 없음. 리프레시 토큰 계열 회전·호출 예약의 advisory lock이 정상적으로 길게
# 기다리는 경로라 켜면 끊긴다. 올리려면 운영 측정값으로 직접 판단한다.
DB_STATEMENT_TIMEOUT_MS=0
DB_LOCK_TIMEOUT_MS=0
# 관리 풀: 화면의 개요·지연시간·상태 조회만 쓴다. 판정 풀과 분리.
DB_ADMIN_POOL_MAX=3
DB_ADMIN_STATEMENT_TIMEOUT_MS=10000
# 직원 PC에서 실행할 수 있는 로컬 MCP 이미지 저장소.
LOCAL_IMAGE_MIRRORS=docker.io/mcp,mcp

# ── 선택 연동(비우면 꺼짐) ──────────────────────────────────────────────────
# GitHub OAuth App의 client id(비밀 아님). 비우면 「내 연결」의 GitHub 기기 인증을 숨긴다.
GITHUB_OAUTH_CLIENT_ID=
# OpenTelemetry 수집기. 쓰면 OTEL_SDK_DISABLED=false와 함께 넣는다.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
# SIEM 전달(./mint.sh up --with-siem). 파일 값은 deploy/siem/ 안의 파일을 /run/siem/… 경로로 적는다.
SIEM_URL=
SIEM_TOKEN_FILE=
SIEM_CA_FILE=
# LiteLLM 승인·철회 동기화(docs/ai/LITELLM_SYNC.md). 직접 적지 말고 ./mint.sh litellm enable로 켠다.
# mint: LiteLLM의 MCP 서버가 MINT를 거친다(권장). direct: LiteLLM이 원래 서버로 바로 보내고 가드레일이 MINT에 묻는다.
MINT_LITELLM_SYNC_URL=
MINT_LITELLM_SYNC_KEY_FILE=
MINT_LITELLM_SYNC_CA_FILE=
MINT_LITELLM_ROUTE=mint
MINT_LITELLM_SYNC_RECHECK_SECONDS=300
# 팀 매핑을 쓰고 LiteLLM 설정 파일에 require_key_mcp_access_defined: true를 둔 것을 확인했으면 1.
MINT_LITELLM_KEY_ACCESS_CONFIRMED=
# 도입 심사 종료 조건 판정 모델(선택). 비우면 규칙으로 판정한다.
TYPESAFE_API_KEY=
