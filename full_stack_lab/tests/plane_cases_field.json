[
  {"id": "github-approved", "harness": "codex", "server": "github", "tool": "list_commits",
   "arguments": {"owner": "MCP-governance", "repo": "mcp-gateway", "perPage": 1, "page": 1, "fields": ["sha", "html_url"]},
   "expect": {"attempted": true, "executed": true, "response": "returned"}},
  {"id": "github-approved", "harness": "claude", "server": "github", "tool": "list_commits",
   "arguments": {"owner": "MCP-governance", "repo": "mcp-gateway", "perPage": 1, "page": 2, "fields": ["sha", "html_url"]},
   "expect": {"attempted": true, "executed": true, "response": "returned"}},
  {"id": "github-profile-read", "harness": "codex", "server": "github", "tool": "get_me", "arguments": {},
   "expect": {"attempted": true, "executed": true}},
  {"id": "github-argument-out-of-scope", "harness": "claude", "server": "github", "tool": "list_commits",
   "arguments": {"owner": "torvalds", "repo": "linux", "perPage": 1, "page": 1, "fields": ["sha"]},
   "expect": {"decision": "Block", "attempted": false, "executed": false}},
  {"id": "github-unapproved-tool", "harness": "codex", "server": "github", "tool": "search_code",
   "arguments": {"query": "repo:MCP-governance/mcp-gateway PAC"},
   "expect": {"decision": "Block", "attempted": false, "executed": false}},
  {"id": "github-concurrent-duplicate", "harness": "codex", "server": "github", "tool": "list_commits", "parallel": 3,
   "arguments": {"owner": "MCP-governance", "repo": "mcp-gateway", "perPage": 2, "page": 1, "fields": ["sha"]},
   "expect_counts": {"executed": 1, "duplicate_blocked": 2}},
  {"id": "context7-approved", "harness": "claude", "server": "context7", "tool": "resolve-library-id",
   "arguments": {"query": "dependency injection in route handlers", "libraryName": "fastapi"},
   "expect": {"attempted": true, "executed": true}},
  {"id": "context7-pii-in-argument", "harness": "codex", "server": "context7", "tool": "resolve-library-id",
   "arguments": {"query": "고객 900101-1234567 주민번호 검증 예제", "libraryName": "fastapi"},
   "expect": {"decision": "Block", "policy_id": "MCP-DATA-EGRESS-001", "attempted": false, "executed": false}},
  {"id": "figma-profile-read", "harness": "claude", "server": "figma", "tool": "whoami", "arguments": {},
   "expect": {"attempted": true, "executed": true, "response": "masked"}},
  {"id": "direct-endpoint-claude", "harness": "claude", "server": "c7direct", "tool": "resolve-library-id",
   "harness_args": ["--mcp-config", "{\"mcpServers\":{\"c7direct\":{\"type\":\"http\",\"url\":\"https://mcp.context7.com/mcp\"}}}"],
   "arguments": {"query": "x", "libraryName": "fastapi"}, "expect": {"transport": "not seen by Gateway"}},
  {"id": "direct-endpoint-codex", "harness": "codex", "server": "c7direct", "tool": "resolve-library-id",
   "harness_args": ["-c", "mcp_servers.c7direct.url=\"https://mcp.context7.com/mcp\""],
   "arguments": {"query": "x", "libraryName": "fastapi"}, "expect": {"transport": "not seen by Gateway"}}
]
