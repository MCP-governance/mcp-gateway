POSTGRES_PASSWORD=demo-only-change-me
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_ALLOWED_REPOS=MCP-governance/mcp-gateway
# AI 코드 감사(AI-Infra-Guard mcp-scan). 세 값이 모두 있어야 실행할 수 있다.
# 로컬 모델 예: Ollama는 http://host.docker.internal:11434/v1, key는 아무 값이나.
MCP_SCAN_API_KEY=
MCP_SCAN_BASE_URL=
MCP_SCAN_MODEL=
# 감사가 도는 시점. 관리자가 기억할 때가 아니라 구조가 정한다.
#   AUTO_ON_VALIDATED  격리 검증을 통과하면 승인 판단 전에 자동으로 큐에 넣는다.
#   REQUIRED_FOR_APPROVAL  그 commit의 감사 결과 없이는 APPROVED로 올릴 수 없다.
#   RESCAN_DAYS  등록 서버를 이 주기로 다시 감사한다. 0이면 끈다.
MCP_SCAN_AUTO_ON_VALIDATED=1
MCP_SCAN_REQUIRED_FOR_APPROVAL=0
MCP_SCAN_RESCAN_DAYS=30
# 워커가 작업을 들고 있겠다고 선언하는 시간. 만료되면 다른 워커가 회수한다.
# 이 값이 없으면 워커가 죽은 작업이 영원히 RUNNING으로 남아 재실행을 막는다.
MCP_SCAN_LEASE_SECONDS=1200
MCP_SCAN_MAX_ATTEMPTS=3
# Console이 "워커 없음"으로 표시하기까지 기다리는 시간.
INTAKE_WORKER_STALE_SECONDS=60
# 모델에게 이 조직의 판단 기준을 함께 준다. 비우면 도구의 일반 기준으로만 판단한다.
MCP_SCAN_PROMPT=
# ── 전주기 종료·폐기 ────────────────────────────────────────────────────────
# 종료 절차의 기한(일). 케이스가 열린 채로 잊히면 "차단은 했으나 아무것도
# 회수되지 않은 상태"가 무기한 지속되고, 그 상태는 판정이 없어 위험 보고에도
# 잡히지 않는다. 넘기면 배너와 메뉴 배지에 올라온다.
TERMINATION_SLA_DAYS=14
# 종료 준비 게이트. 켜면 원격 MCP는 제공자의 하위 자격 고지 조항 없이 승인되지
# 않는다. 고지 없이 들인 이용 관계는 끝낼 때 반드시 T3(판단 불가)가 된다.
INTAKE_EXIT_TERMS_REQUIRED=0
# ── 엔드포인트 평면 (./console.sh endpoint) ─────────────────────────────────
# 관측할 클라이언트 설정 디렉터리. 읽기 전용으로 마운트되며 에이전트에는 쓰기
# 경로가 없다. 실제 PC를 보려면 그 경로를 준다:
#   ENDPOINT_CONFIG_SOURCE=/mnt/c/Users/<계정>/AppData/Roaming/Claude
ENDPOINT_CONFIG_SOURCE=./endpoint/sample-configs
ENDPOINT_ID=endpoint-dev-001
ENDPOINT_REPORT_SECONDS=60
# 장치 자격. 관리자가 발급한다: ./console.sh endpoint-key <endpoint-id> <owner-token>
# 에이전트는 이 키 하나만 갖고, 이 키로 할 수 있는 일은 인벤토리·리스너 보고뿐이다.
# 이전 판처럼 관리자 계정으로 로그인하지 않는다.
ENDPOINT_DEVICE_KEY=
# 망 탐색 수행 여부. 대역·포트·주기는 게이트웨이의 탐색 정책이 정한다.
ENDPOINT_NETSCAN=1
# 장치 키 해시에 섞는 조직 고유 값. 비워도 동작하지만, 설정하면 DB만 새어도
# 키를 역산할 수 없다.
ENDPOINT_KEY_PEPPER=
# Generated by ./console.sh inside the gateway image. Only agent-service receives the
# private key; the gateway and gateway-sse receive the public key and therefore
# cannot mint a token.
AGENT_JWT_PRIVATE_KEY=
AGENT_JWT_PUBLIC_KEY=
MOCK_SSO_PASSWORD=test-password
MODEL_MODE=mock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=20

# Identity for a manually spawned stdio ingress (python -m app.stdio_entry).
# stdio carries no headers, so the principal is bound once at process start.
# Unset means the ingress has no identity and refuses every call.
GATEWAY_STDIO_PRINCIPAL=
# Upper bound on an upstream tool result the gateway will hand back (bytes).
MAX_RESULT_BYTES=262144
# Shared PostgreSQL pool per process (gateway, agent-service).
DB_POOL_MAX=10
DB_POOL_TIMEOUT=10
# How long a claimed but unanswered /tool-call receipt stays "in flight" before it
# is settled as unconfirmed. It is never retried.
RECEIPT_TIMEOUT_MINUTES=5
# Initial enforcement mode when gateway_settings has no row yet: enforce or monitor.
# After the first boot the database value wins so an operator can switch without a
# restart, and the switch itself is recorded.
GATEWAY_ENFORCEMENT=enforce
# Call-rate ceiling per principal, measured from the audit table so it holds across
# replicas. Enforced even in monitor mode: it protects the gateway, it is not an
# opinion about who may read what.
RATE_LIMIT_CALLS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Volume escalation: this many important-data calls inside the window turns the next
# one into an approval, so a drip-by-drip read of everything is not 20 clean Allows.
IMPORTANT_BURST_LIMIT=10
IMPORTANT_BURST_MINUTES=5
# Login attempts per client+address before 429. Per process; ingress does the rest.
LOGIN_ATTEMPT_LIMIT=10
LOGIN_ATTEMPT_WINDOW_SECONDS=300
