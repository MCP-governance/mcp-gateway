POSTGRES_PASSWORD=demo-only-change-me
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_ALLOWED_REPOS=MCP-governance/mcp-gateway
MCP_SCAN_API_KEY=
MCP_SCAN_BASE_URL=
MCP_SCAN_MODEL=
AGENT_JWT_SECRET=
MOCK_SSO_PASSWORD=test-password
MODEL_MODE=mock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=20

# Identity for a manually spawned stdio ingress (python -m app.stdio_entry).
# stdio carries no headers, so the principal is bound once at process start.
# Unset means the ingress has no identity and refuses every call.
GATEWAY_STDIO_PRINCIPAL=
# Upper bound on an upstream tool result the gateway will hand back (bytes).
MAX_RESULT_BYTES=262144
