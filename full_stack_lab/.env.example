# ./console.sh는 .env가 없어도 처음 실행할 때 필요한 값을 만들어 적는다: compose 프로젝트
# 이름, 내부망 대역, 합성 IdP 서명 키, LiteLLM 마스터 키, 직원 PC별 LLM 키·장치 키.
# 아래 값은 바꾸고 싶을 때만 .env에 옮겨 적는다. compose.yaml이 컨테이너에 넘기는
# 변수만 효과가 있다(맨 아래 "코드 기본값" 참고).

# ── 한 Docker 호스트에 실습을 여러 벌 띄울 때 ────────────────────────────────
# 게시 포트. 모두 127.0.0.1에만 열린다.
CONSOLE_PORT=8000
GATEWAY_PORT=8080
JAEGER_PORT=16686
GITEA_PORT=3000
# 내부망 /16의 앞 두 자리(예: 10.238). 비우면 console.sh가 다른 Docker 망·라우팅과
# 겹치지 않는 10.200–10.249 중 하나를 골라 .env에 고정한다(docs/ai/DECISIONS.md D-24).
MCP_NET_PREFIX=
# 비우면 체크아웃 경로의 해시로 정한다(mcpgw-xxxxxxxxxx).
MCP_COMPOSE_PROJECT=

# ── 실습 전용 비밀번호 ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=demo-only-change-me
CORP_DB_PASSWORD=corp-owner-lab-only
GITEA_ADMIN_USER=corpadmin
GITEA_ADMIN_PASSWORD=corp-admin-lab-only
GITEA_BOT_PASSWORD=mcp-bot-lab-only
MOCK_SSO_PASSWORD=test-password
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_HOURS=8

# ── 직원 PC(하네스)와 로컬 LLM ──────────────────────────────────────────────
# 7.6GB WSL VM에서는 2B가 한계(D-32). 메모리가 넉넉하면 qwen3.5:4b + 16384.
LOCAL_LLM_MODEL=qwen3.5:2b-q4_K_M
LOCAL_LLM_CONTEXT=12288
# llama.cpp 스레드 수. hybrid CPU(P+E 코어)에서는 논리 코어 수보다 6~8이 빠르다.
LOCAL_LLM_THREADS=6
# workday 기본 모드. llm: 하네스의 모델이 도구를 고른다 · scripted: MCP Inspector CLI가 정해진 호출(CI와 test)
AGENT_MODE=llm
# 1: 소형 CPU 모델용으로 하네스 프롬프트를 줄이고 내장 도구를 끈다(MCP 경로는 그대로). 클라우드 모델이면 0.
BOB_HARNESS_COMPACT=1

# ── 도입 심사: 격리 검증과 AI 코드 감사(AI-Infra-Guard mcp-scan) ─────────────
# 세 값이 모두 있어야 감사를 실행할 수 있다.
MCP_SCAN_API_KEY=
MCP_SCAN_BASE_URL=
MCP_SCAN_MODEL=
MCP_SCAN_LANGUAGE=en
MCP_SCAN_TIMEOUT=900
# 감사가 도는 시점은 관리자가 기억할 때가 아니라 구조가 정한다.
#   AUTO_ON_VALIDATED      격리 검증을 통과하면 승인 판단 전에 자동으로 큐에 넣는다.
#   REQUIRED_FOR_APPROVAL  그 commit의 감사 결과 없이는 APPROVED로 올릴 수 없다.
#   RESCAN_DAYS            등록 서버를 이 주기로 다시 감사한다. 0이면 끈다.
MCP_SCAN_AUTO_ON_VALIDATED=1
MCP_SCAN_REQUIRED_FOR_APPROVAL=0
MCP_SCAN_RESCAN_DAYS=30
MCP_SCAN_RESCAN_SWEEP_SECONDS=900
# 워커가 작업을 들고 있겠다고 선언하는 시간. 만료되면 다른 워커가 회수한다.
MCP_SCAN_LEASE_SECONDS=1200
MCP_SCAN_MAX_ATTEMPTS=3
INTAKE_POLL_SECONDS=5
INTAKE_WORKER_ID=intake-worker-1
# Console이 "워커 없음"으로 표시하기까지 기다리는 시간.
INTAKE_WORKER_STALE_SECONDS=60
# 원격(HTTP·SSE) MCP의 종료 조건은 설정으로 끄지 않는다. 관리자가 제공자 문서로
# 검증해 기록해야 승인된다(PUT /api/mcp-requests/{id}/exit-terms).

# ── 종료·폐기 ────────────────────────────────────────────────────────────────
# 종료 케이스 기한(일). 넘기면 개요와 메뉴 배지에 올라온다.
TERMINATION_SLA_DAYS=14

# ── console.sh가 생성한다 (직접 적지 않는다) ────────────────────────────────
# AGENT_JWT_PRIVATE_KEY / AGENT_JWT_PUBLIC_KEY  합성 IdP Ed25519 키. 개인키는 agent-service만 받는다.
# LITELLM_MASTER_KEY, LLM_KEY_WS_<이름>, ENDPOINT_KEY_WS_<이름>

# ── 코드 기본값 ─────────────────────────────────────────────────────────────
# 아래는 코드가 읽지만 compose.yaml이 컨테이너에 넘기지 않으므로 .env에 적어도 바뀌지
# 않는다. 바꾸려면 compose.yaml의 해당 서비스 environment에 추가한다.
#   gateway        GATEWAY_ENFORCEMENT(enforce) RATE_LIMIT_CALLS(60) RATE_LIMIT_WINDOW_SECONDS(60)
#                  IMPORTANT_BURST_LIMIT(10) IMPORTANT_BURST_MINUTES(5) MAX_RESULT_BYTES(262144)
#                  ENDPOINT_KEY_PEPPER() DB_POOL_MAX(10) DB_POOL_TIMEOUT(10)
#   agent-service  LOGIN_ATTEMPT_LIMIT(10) LOGIN_ATTEMPT_WINDOW_SECONDS(300)
#   intake-worker  MCP_SCAN_PROMPT()
