POSTGRES_PASSWORD=demo-only-change-me
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_ALLOWED_REPOS=MCP-governance/mcp-gateway
MCP_SCAN_API_KEY=
MCP_SCAN_BASE_URL=
MCP_SCAN_MODEL=
# Generated by ./demo.sh inside the gateway image. Only agent-service receives the
# private key; the gateway and gateway-sse receive the public key and therefore
# cannot mint a token.
AGENT_JWT_PRIVATE_KEY=
AGENT_JWT_PUBLIC_KEY=
MOCK_SSO_PASSWORD=test-password
MODEL_MODE=mock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=20

# Identity for a manually spawned stdio ingress (python -m app.stdio_entry).
# stdio carries no headers, so the principal is bound once at process start.
# Unset means the ingress has no identity and refuses every call.
GATEWAY_STDIO_PRINCIPAL=
# Upper bound on an upstream tool result the gateway will hand back (bytes).
MAX_RESULT_BYTES=262144
# Shared PostgreSQL pool per process (gateway, agent-service).
DB_POOL_MAX=10
DB_POOL_TIMEOUT=10
# How long a claimed but unanswered /tool-call receipt stays "in flight" before it
# is settled as unconfirmed. It is never retried.
RECEIPT_TIMEOUT_MINUTES=5
# Initial enforcement mode when gateway_settings has no row yet: enforce or monitor.
# After the first boot the database value wins so an operator can switch without a
# restart, and the switch itself is recorded.
GATEWAY_ENFORCEMENT=enforce
