{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "bob": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BoB LLM Gateway",
      "options": {"baseURL": "http://llm-gateway:4000/v1", "apiKey": "{env:BOB_LLM_KEY}"},
      "models": {"bob-assistant": {"name": "bob-assistant", "tool_call": true}}
    }
  },
  "model": "bob/bob-assistant",
  "small_model": "bob/bob-assistant",
  "agent": {
    "bob": {
      "mode": "primary",
      "description": "Company assistant on the local model: MCP tools only",
      "prompt": "{file:/etc/bob/harness-prompt.md}",
      "tools": {"bash": false, "edit": false, "write": false, "patch": false, "webfetch": false, "websearch": false, "todowrite": false, "todoread": false, "task": false}
    }
  }
}
