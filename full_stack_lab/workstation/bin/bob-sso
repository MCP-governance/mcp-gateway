#!/usr/bin/env python3
"""bob-sso: the company SSO credential helper on an employee PC.

Harnesses take an MCP bearer token from a command or an environment variable; this
is that command. It signs in to the company IdP as the PC's user (OAuth password
grant standing in for SSO, client_id = workstation), keeps the refresh token in
~/.cache/bob-sso and hands out a fresh access token (10-minute JWT).

    bob-sso token     access token            (Codex bearer_token_env_var, Gemini/OpenCode env)
    bob-sso header    {"Authorization": ...}  (Claude Code headersHelper)
"""
import fcntl
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

IDP = os.getenv("IDP_URL", "http://agent-service:8000").rstrip("/")
CLIENT = os.getenv("WORKSTATION_ID") or os.uname().nodename
CACHE = Path.home() / ".cache" / "bob-sso" / "token.json"


def grant(fields: dict) -> dict | None:
    body = urllib.parse.urlencode({**fields, "client_id": CLIENT}).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request(f"{IDP}/oauth/token", body), timeout=20) as response:
            return json.load(response)
    except urllib.error.HTTPError as exc:
        if fields["grant_type"] == "refresh_token":
            return None  # expired or revoked: fall back to signing in again
        detail = json.loads(exc.read() or b"{}").get("error_description", exc.code)
        sys.exit(f"bob-sso: 로그인 실패 ({detail})")


def token() -> str:
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    with open(CACHE.with_suffix(".lock"), "w") as lock:
        # Several MCP connections start at once (one per server); one sign-in serves them all.
        fcntl.flock(lock, fcntl.LOCK_EX)
        cached = json.loads(CACHE.read_text()) if CACHE.exists() else {}
        if cached.get("access_token") and time.time() < cached.get("expires_at", 0) - 60:
            return cached["access_token"]
        data = grant({"grant_type": "refresh_token", "refresh_token": cached["refresh_token"]}) \
            if cached.get("refresh_token") else None
        data = data or grant({"grant_type": "password", "username": os.environ["EMPLOYEE_EMAIL"],
                              "password": os.environ["EMPLOYEE_PASSWORD"]})
        data["expires_at"] = time.time() + int(data.get("expires_in", 600))
        data.setdefault("refresh_token", cached.get("refresh_token"))
        CACHE.write_text(json.dumps(data))
        CACHE.chmod(0o600)
        return data["access_token"]


if __name__ == "__main__":
    command = sys.argv[1] if len(sys.argv) > 1 else "token"
    if command == "token":
        print(token())
    elif command == "header":
        print(json.dumps({"Authorization": f"Bearer {token()}"}))
    else:
        sys.exit(__doc__)
