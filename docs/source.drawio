        <mxCell id="EKwQxOCetbGDIcymAig8-465" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;span&gt;구분&lt;/span&gt;&lt;/th&gt;&lt;th&gt;&lt;span&gt;오픈소스 / 버전&lt;/span&gt;&lt;/th&gt;&lt;th&gt;&lt;span&gt;테스트베드 사용처&lt;/span&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;AI 보안&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Tencent AI-Infra-Guard&amp;nbsp;&lt;/span&gt;&lt;code&gt;4.6.3&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;AIG Web·Agent 및 &lt;font&gt;MCP Scan&lt;/font&gt;&lt;/span&gt;&lt;span&gt;&amp;nbsp;검사&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;정책&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Open Policy Agent 1.20.2&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;MCP 인가·차단 정책&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;취약점/SCA&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Trivy 0.74.0&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;이미지·패키지 취약점 검사&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;데이터 통신&lt;/td&gt;&lt;td&gt;Presidio 2.2.364&lt;/td&gt;&lt;td&gt;크리덴셜 마스킹 처리&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;DB&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;PostgreSQL 18 Alpine&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;도입·검사·퇴역 이력 저장&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;MCP 런타임&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;MCP Python SDK 2.2.0&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;게이트웨이 및 모의 MCP 서버&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;웹/API&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;FastAPI 0.141.1, Uvicorn 0.52.4&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Gateway, API, 모의 서버&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;관측성&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;OpenTelemetry 1.44.0&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;추적 데이터 전송&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;인증/검증&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Keycloak&amp;nbsp;26.7.4&lt;/td&gt;&lt;td&gt;&lt;span&gt;토큰·스키마 검증&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;DB 드라이버&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Psycopg 3.3.5, Psycopg Pool 3.3.1&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;PostgreSQL 연결&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;HTTP&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;HTTPX 0.28.1&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;내부 서비스 호출&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;기본 환경&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;Python 3.12 slim, Docker Compose&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;격리된 가상 사내망 실행&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
