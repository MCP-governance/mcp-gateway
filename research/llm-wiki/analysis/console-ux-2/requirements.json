  "requirements": [
    {
      "id": "A02",
      "name": "호출 결과 축",
      "symbols": "outcomes.endpoint_outcome·recorded_outcome, activity.describe, audit.with_outcome, endpoint_plane.tool_events_page, GATEWAY_DECISION, decisionRow·showDecision·auditTabs",
      "behavior": "경로·정책 판정·도구 실행·업무 결과를 별도 표시한다. 경보/제한은 허용과 구분한다. 후보 1개만 보조 연결하고 복수 후보는 연결 없음으로 둔다. 출력 크기로 성공을 추정하지 않는다.",
      "tests": "console_ux2_check.py::Axes; ReadModels.test_endpoint_link_ambiguity_and_redacted_projection; console-ia 결과 축 시험",
      "status": "implemented-local-checks-passed"
    },
    {
      "id": "A03",
      "name": "사유에서 조치·근거로 이동",
      "symbols": "decisionAction·shadowLink·alertTarget, route, ACTIONS.endpoint-record·alert-detail, audit.alerts",
      "behavior": "차단·경보 상단에 사유·실행·조치를 표시한다. 미등록 경보의 출처/원본 ID를 설정·수신기 링크로 변환한다. endpoint·record_kind·record_id 소비와 서버/도구별 역할별 동의 직행을 구현했다.",
      "tests": "console-ia 미등록 MCP 조치; 근거 직행 URL; Python 경보 원본 연결",
      "status": "implemented-local-checks-passed"
    },
    {
      "id": "A05",
      "name": "같은 기간의 경보",
      "symbols": "main.audit_alerts, audit.alerts, ROUTES.overview, auditTabs",
      "behavior": "대시보드 집계의 절대 시작·종료를 URL에 넣고 목록 API에 적용한다. 감사 탭의 로드 행 수 배지를 제거하고 표시 건수와 다음 페이지를 본문에 둔다.",
      "tests": "ReadModels.test_alert_window_pagination_unread_and_evidence_navigation; console-ia 경보 기간",
      "status": "implemented-local-checks-passed"
    },
    {
      "id": "A06",
      "name": "사용자·기기 조회",
      "symbols": "main.device_filters, endpoint_plane.device_filter·agents·inventory_page·listeners_page·os_events_page, ROUTES.people·covPage",
      "behavior": "서버가 검색·상태·ID 조건을 행과 전체 건수에 공통 적용한다. 세 표를 같은 엔드포인트 집합으로 좁힌다. 사용자·호스트·PC 계정을 별도 열과 선택 기기 dl.kv로 표시한다.",
      "tests": "ReadModels.test_device_filters_apply_to_rows_counts_and_agents; console-ia 엔드포인트 검색",
      "status": "implemented-local-checks-passed"
    },
    {
      "id": "A07",
      "name": "URL·뒤로가기 복원",
      "symbols": "rememberDetail·rememberTab·openDrawer·closeDrawer·route·rememberFeed·covPage, 상세 핸들러",
      "behavior": "최초 상세 push, 상세 전환/탭 replace, 진입 표식 있는 닫기 back. 직접 링크 닫기·호출 필터/페이지·재고 커서 이력·상세 탭 복원과 중복 이동 제거를 구현했다.",
      "tests": "console-ia 최초 push/replace/back; 목록 URL; 근거 상세 탭 복원; MCP 설정 다음 페이지",
      "status": "implemented-local-checks-passed"
    },
    {
      "id": "A10",
      "name": "신청 폼 복구·경쟁",
      "symbols": "intakeStatus·resetIntakeTools·requestedToolList, FORMS.intake, ACTIONS.intake-discover, input/change/invalid 이벤트",
      "behavior": "각 입력/도구에 aria-invalid·aria-describedby와 인접 오류를 연결했다. 조회 중복·제출 중복을 막고 주소·유형·연결 방식 변경 뒤 늦은 조회 결과를 버린다. 실패 후 입력·선택을 유지한다.",
      "tests": "console-ia 조회 경쟁/실패/재시도; 신청 실패와 필드 오류; 기존 원클릭 검사",
      "status": "implemented-local-checks-passed"
    },
    {
      "id": "A11",
      "name": "경보 묶음과 미열람",
      "symbols": "alertGroups·groupedAlerts·markAlertsSeen·refreshAlertBell, audit.alerts",
      "behavior": "종류·대상·사유로 표시 창의 원본을 묶어 건수·최초/최근을 보여 주고 details로 원본 전체를 조회한다. 읽음 ID 구간을 사용자별로 저장하며 서버가 표시 제한과 무관한 미열람 수를 센다. 삭제·자동 종결은 없다.",
      "tests": "console-ia 경보 그룹·원본 보존; 필터된 읽음/전체 미열람; Python 읽음 SQL 조건",
      "status": "implemented-local-checks-passed"
    },
    {
      "id": "A12",
      "name": "도구별 동의",
      "symbols": "consentTabs, ACTIONS.consent·consent-server",
      "behavior": "대기 도구마다 동의·거부를 제공한다. 일괄 조작 전 표시된 도구 수·목적지·등급을 dl.kv로 확인하고 취소 시 API를 호출하지 않는다. 기존 본인 동의 인가와 ID 집합 검증을 유지한다.",
      "tests": "consent-per-server-console.test.mjs; console-ia 동의 필터/확인 취소",
      "status": "implemented-local-checks-passed"
    },
    {
      "id": "A17",
      "name": "종료 예상·실제 구분",
      "symbols": "ROUTES.termination·relationshipRow",
      "behavior": "관계·케이스 목록에 현재 준비도에 따른 예상 결과와 최근 케이스의 실제 결과를 분리하고 기존 증거 탭 링크를 제공한다. 종료 판정 규칙은 변경하지 않았다.",
      "tests": "console-ia 종료 목록 시험; session_termination_check.py; tool_sunset_snapshot_check.py",
      "status": "implemented-local-checks-passed"
    },
    {
      "id": "A18",
      "name": "짧은 상태와 배포 소스",
      "symbols": "toast·api·startAdminSessionGuard, console.html, 자체 agent_static JS/MJS",
      "behavior": "알림·공통 오류·만료창을 상태/사유/결과/만료 시각/재로그인 라벨과 값으로 표시한다. 서버의 한국어 오류 사유는 이스케이프해 유지한다. 자체 배포 소스의 개발 주석을 제거하고 시험 추출 경계는 함수명으로 바꿨다. vendor 라이선스는 보존했다.",
      "tests": "console_copy_check.py; i18n.test.mjs; console-ia 배포 주석/만료창",
      "status": "implemented-local-checks-passed"
    },
    {
      "id": "A14",
      "name": "빈 상태 보강",
      "symbols": "empty·endpointSettings·consentTabs·ROUTES.people·groupedAlerts",
      "behavior": "정상 빈 목록, 조건 결과 없음, 조회 실패를 구분한다. 정상/검색은 status, 실패/필드 오류는 alert를 유지한다.",
      "tests": "console-ia 빈 상태·실패/복구; 기존 전체 회귀",
      "status": "implemented-local-checks-passed"
