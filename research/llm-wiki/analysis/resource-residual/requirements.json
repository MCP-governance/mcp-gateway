  "requirements": [
    {
      "id": "RS-01",
      "requirement": "Fresh issuer introspection and immediate access revocation",
      "code": [
        "idp.introspection",
        "idp.introspect",
        "agent_contract.authenticated_user"
      ],
      "local_test": [
        "Introspection.test_access_requeries_after_revocation_and_response_is_not_cacheable",
        "Introspection.test_access_account_and_managed_state_are_current",
        "Introspection.test_access_invalid_signature_and_signed_disposal_never_reuse_active"
      ],
      "pg_test": [
        "issued_tokens"
      ],
      "cases": [
        "normal",
        "negative",
        "failure"
      ],
      "limit": "Local JWT/DB responses are doubles. Issuer response is not remote resource rejection.",
      "local_status": "passed-unit-doubles",
      "postgres_status": "unexecuted"
    },
    {
      "id": "RS-02",
      "requirement": "Refresh introspection matches current account and grant path",
      "code": [
        "idp.introspection"
      ],
      "local_test": [
        "Introspection.test_refresh_account_stop_then_recovery_requeries",
        "Introspection.test_refresh_missing_account_managed_transition_and_oidc_are_inactive",
        "Introspection.test_refresh_revoked_rotated_expired_unknown_and_signed_list",
        "Introspection.test_db_failure_does_not_fall_back_to_previous_active"
      ],
      "pg_test": [
        "account_transition"
      ],
      "cases": [
        "normal",
        "negative",
        "boundary",
        "failure",
        "recovery"
      ],
      "limit": "Does not change issuance/rotation or close the D-154 commit-to-append crash window.",
      "local_status": "passed-unit-doubles",
      "postgres_status": "unexecuted"
    },
    {
      "id": "RS-03",
      "requirement": "Resource acceptance overrides issuer inactive for token targets",
      "code": [
        "decommission.STATE_EVIDENCE_FOR",
        "decommission._judge_target"
      ],
      "local_test": [
        "Evidence.test_resource_acceptance_overrides_inactive_introspection_for_token_kinds",
        "Evidence.test_resource_rejection_is_token_state_evidence_but_old_evidence_is_not"
      ],
      "pg_test": [
        "target_grades"
      ],
      "cases": [
        "normal",
        "negative",
        "boundary"
      ],
      "limit": "Acceptance/rejection unit evidence is synthetic. No external JWT resource server is introduced.",
      "local_status": "passed-unit-doubles",
      "postgres_status": "unexecuted"
    },
    {
      "id": "RS-04",
      "requirement": "Separate server-held downstream credential and direct reaccess",
      "code": [
