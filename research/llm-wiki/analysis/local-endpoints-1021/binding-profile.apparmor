profile mcpgw-unit-bound-credential {
  #include <abstractions/base>
  /etc/** r,
  /usr/** mr,
  /lib{,32,64}/** mr,
  /proc/** r,
  deny ptrace (trace, read, tracedby, readby),
  deny capability sys_ptrace,
  deny /proc/*/{mem,environ} r,
  deny /proc/*/task/*/{mem,environ} r,
  /usr/bin/python3{,.[0-9]*} ix,

  /run/mcpgw-unit.sock rw,
  unix (create, getattr, getopt, setopt, shutdown) type=stream,
  unix (connect, send, receive) type=stream peer=(addr="/run/mcpgw-unit.sock", label=unconfined),
}
